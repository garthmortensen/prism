# Prism Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://ra_user:ra_pass@localhost:5432/ra_database

# PostgreSQL Credentials (for docker-compose)
POSTGRES_USER=ra_user
POSTGRES_PASSWORD=ra_pass
POSTGRES_DB=ra_database

# Dagster Configuration
DAGSTER_HOME=.dagster_home

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Optional: Override default ports
# POSTGRES_PORT=5432
# DAGSTER_PORT=3000

# Optional: Production database (e.g., AWS RDS, Cloud SQL)
# DATABASE_URL=postgresql://user:pass@prod-db.example.com:5432/ra_database

# Optional: Snowflake connection (for prod environment)
# SNOWFLAKE_ACCOUNT=your_account
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_DATABASE=your_database
# SNOWFLAKE_SCHEMA=your_schema
# SNOWFLAKE_WAREHOUSE=your_warehouse
